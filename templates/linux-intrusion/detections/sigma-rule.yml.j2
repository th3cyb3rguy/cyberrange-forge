title: Simulated Linux Intrusion Indicators

id: 0e6c51e6-71e4-4e7b-8c65-linux-lab

status: experimental

description: Detects simulated Linux intrusion indicators generated by CyberRange Forge.

author: CyberRange Forge

date: 2026/06/20

logsource:
  product: linux

detection:

  failed_logins:
    message|contains:
      - "Failed password"
      - "invalid user"

  suspicious_cron:
    message|contains:
      - "/tmp/.update.sh"

  sensitive_file_access:
    message|contains:
      - "/etc/shadow"

  condition: failed_logins or suspicious_cron or sensitive_file_access

falsepositives:
  - Authorized penetration testing
  - Security training
  - Administrator activity

level: high

tags:
  - attack.credential_access
  - attack.persistence
  - attack.privilege_escalation
  - attack.t1110
  - attack.t1053
